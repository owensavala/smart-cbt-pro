# ==========================================
# DATABASE CONNECTION (PostgreSQL)
# ==========================================
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://smartcbt_user:smartcbt_password@localhost:5432/smartcbt_db?schema=public"

# ==========================================
# NEXT.JS ENVIRONMENT
# ==========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="SmartCBT Pro"
NEXT_PUBLIC_APP_VERSION="1.1.0"

